# Decision Tree Classifier

from sklearn.tree import DecisionTreeClassifier

# Training Data
X = [[0,0], [0,1], [1,0], [1,1]]
Y = [0, 1, 1, 0]

# Create Model
model = DecisionTreeClassifier()

# Train Model
model.fit(X, Y)

# Prediction
test = [[1,0]]
prediction = model.predict(test)

print("Prediction:", prediction[0])
